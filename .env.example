# .env.example
# Copy to .env and override any values you want to change.
# All settings have sensible defaults — no changes required to run locally.

# ── LLM ───────────────────────────────────────────────────────────────────────
# Switch model (must be pulled via `ollama pull <model>` first)
# LLM_MODEL=gemma3:4b
# LLM_MODEL=llama3.2:3b-instruct-q4_K_M   # memory-constrained fallback
# LLM_MODEL=mistral:7b-instruct-v0.3-q4_K_M  # higher quality, needs 4.5GB
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── Retrieval ─────────────────────────────────────────────────────────────────
# RETRIEVAL_TOP_K=15
# BM25_WEIGHT=0.4
# VECTOR_WEIGHT=0.6

# ── Chunking ──────────────────────────────────────────────────────────────────
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200

# ── Paths (rarely need changing) ──────────────────────────────────────────────
# RAW_DATA_DIR=data/raw
# PROCESSED_DATA_DIR=data/processed