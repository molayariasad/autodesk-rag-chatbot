# ==========================================
# Python & Environment
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# ==========================================
# Build Artifacts
# ==========================================
*.egg-info/
build/
dist/
*.eggs/

# ==========================================
# Data, Vector DBs, Large Files
# ==========================================

# Raw HTML corpus — too large for git (~hundreds of MB)
data/raw/

# ChromaDB vector index — rebuilt via --force-ingest
data/chroma_db/

# TruLens SQLite DB — rebuilt by running evaluations
data/processed/trulens.sqlite

# Evaluation JSON exports — regenerated by eval runs, stored in Google Drive
data/processed/experiment_results/

# Ingestion artifacts
data/processed/ingestion_report.json
data/processed/*.flag
data/processed/*.pkl

# Generic DB exclusions
*.sqlite3
*.db

# ==========================================
# KEEP in git (lightweight, essential)
# ==========================================
# data/eval/eval_questions.json      ← test suite, reviewers need this
# data/processed/corpus_analysis/    ← PNG EDA plots (~2MB total)
# data/processed/metrics_analysis/   ← PNG experiment plots (~2MB total)

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# IDE & Tooling
# ==========================================
.idea/
.vscode/
*.swp